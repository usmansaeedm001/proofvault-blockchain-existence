SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=https://app.proofvault.example
DB_URL=<production-mysql-jdbc-url>
DB_USERNAME=<production-db-user>
DB_PASSWORD=<production-db-password>
AUTHENTICATION_ENABLED=true
OAUTH2_ISSUER_URI=https://auth.proofvault.example
OAUTH2_JWK_SET_URI=https://auth.proofvault.example/oauth2/jwks
OAUTH2_AUDIENCE=proofvault-api
BLOCKCHAIN_MODE=ethereum
BLOCKCHAIN_NETWORK=<production-network-name>
BLOCKCHAIN_RPC_URL=<production-rpc-url>
BLOCKCHAIN_CHAIN_ID=<production-chain-id>
EXPLORER_BASE_URL=<production-explorer-tx-base-url>
PROOFVAULT_CONTRACT_ADDRESS=<production-proxy-address>
PROOFVAULT_ANCHOR_ADDRESS=<production-anchor-address>
PROOFVAULT_ANCHOR_PRIVATE_KEY=<secret-manager-value>
OTEL_TRACING_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=<production-otel-endpoint>
OTEL_TRACES_SAMPLER_PROBABILITY=0.05
