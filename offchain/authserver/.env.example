# Default example: Anvil local chain profile.
SPRING_PROFILES_ACTIVE=anvil
SERVER_PORT=9000
DB_URL=jdbc:mysql://localhost:3306/proofvault_auth?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=proofvault
DB_PASSWORD=proofvault_local_password

AUTH_ISSUER=http://localhost:9000
AUTH_AUDIENCE=proofvault-api
AUTH_ALLOWED_ORIGINS=http://localhost:5173
AUTH_BOOTSTRAP_ENABLED=true
AUTH_BOOTSTRAP_USER_EMAIL=admin@proofvault.local
AUTH_BOOTSTRAP_USER_PASSWORD=ChangeMeLocal123!
AUTH_BOOTSTRAP_CLIENT_ID=proofvault-web
AUTH_BOOTSTRAP_CLIENT_SECRET=proofvault-local-secret
AUTH_FRONTEND_PUBLIC_CLIENT_ID=proofvault-spa
AUTH_FRONTEND_REDIRECT_URI=http://localhost:5173/oauth2/callback
AUTH_FRONTEND_LOGOUT_REDIRECT_URI=http://localhost:5173

AUTH_SIGNING_REQUIRE_CONFIGURED_KEY=false
AUTH_SIGNING_PRIVATE_KEY_PEM=
AUTH_SIGNING_PUBLIC_KEY_PEM=

AUTH_WALLET_ENABLED=true
AUTH_WALLET_CHAIN_ID=31337
AUTH_WALLET_DOMAIN=localhost:5173
AUTH_WALLET_URI=http://localhost:5173
AUTH_WALLET_NONCE_TTL=5m

OTEL_TRACING_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
