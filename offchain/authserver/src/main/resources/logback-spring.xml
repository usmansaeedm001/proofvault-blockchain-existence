<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

  <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="proofvault-authserver"/>
  <property name="CONSOLE_LOG_PATTERN"
            value="%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level service=${appName} traceId=%X{traceId:-} spanId=%X{spanId:-} requestId=%X{requestId:-} thread=&quot;%thread&quot; logger=%logger{40} - %msg%n%wEx"/>

  <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

  <root level="${LOG_LEVEL_ROOT:-INFO}">
    <appender-ref ref="CONSOLE"/>
  </root>

  <logger name="com.proofvault" level="${LOG_LEVEL_PROOFVAULT:-INFO}"/>
</configuration>
