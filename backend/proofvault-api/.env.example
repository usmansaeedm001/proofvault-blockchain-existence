# Common
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173
MAX_FILE_SIZE=25MB
MAX_REQUEST_SIZE=25MB

# Database
# local defaults to H2. dev/staging/prod should use MySQL.
DB_URL=jdbc:mysql://localhost:3306/proofvault
DB_USERNAME=proofvault
DB_PASSWORD=proofvault
DB_DRIVER=com.mysql.cj.jdbc.Driver
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2

# OAuth2 / OIDC resource server
# local profile defaults AUTHENTICATION_ENABLED=false.
# Docker/dev/staging/prod should use AUTHENTICATION_ENABLED=true and a trusted issuer.
AUTHENTICATION_ENABLED=false
OAUTH2_ISSUER_URI=http://localhost:9000
OAUTH2_JWK_SET_URI=
OAUTH2_AUDIENCE=proofvault-api
OAUTH2_EMAIL_CLAIM=email
OAUTH2_NAME_CLAIM=preferred_username

# Blockchain anchoring
BLOCKCHAIN_MODE=mock
BLOCKCHAIN_NETWORK=local-foundry
EXPLORER_BASE_URL=http://localhost:8545/tx/
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_CHAIN_ID=31337
BLOCKCHAIN_GAS_PRICE_WEI=1000000000
BLOCKCHAIN_GAS_LIMIT=500000
PROOFVAULT_CONTRACT_ADDRESS=
PROOFVAULT_ANCHOR_ADDRESS=
PROOFVAULT_ANCHOR_PRIVATE_KEY=

# OpenTelemetry / observability
OTEL_TRACING_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_TRACES_SAMPLER_PROBABILITY=1.0
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_PROOFVAULT=INFO
