# Default example: Anvil local chain profile.
SPRING_PROFILES_ACTIVE=anvil
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173
MAX_FILE_SIZE=25MB
MAX_REQUEST_SIZE=25MB

DB_URL=jdbc:mysql://localhost:3306/proofvault?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=proofvault
DB_PASSWORD=proofvault_local_password
DB_DRIVER=com.mysql.cj.jdbc.Driver

AUTHENTICATION_ENABLED=true
OAUTH2_ISSUER_URI=http://localhost:9000
OAUTH2_JWK_SET_URI=http://localhost:9000/oauth2/jwks
OAUTH2_AUDIENCE=proofvault-api
OAUTH2_EMAIL_CLAIM=email
OAUTH2_NAME_CLAIM=preferred_username

BLOCKCHAIN_MODE=ethereum
BLOCKCHAIN_NETWORK=local-anvil
EXPLORER_BASE_URL=http://172.25.179.4:8545/tx/
BLOCKCHAIN_RPC_URL=http://172.25.179.4:8545
BLOCKCHAIN_CHAIN_ID=31337
BLOCKCHAIN_GAS_PRICE_WEI=1000000000
BLOCKCHAIN_GAS_LIMIT=500000
PROOFVAULT_CONTRACT_ADDRESS=
PROOFVAULT_ANCHOR_ADDRESS=
PROOFVAULT_ANCHOR_PRIVATE_KEY=

OTEL_TRACING_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_TRACES_SAMPLER_PROBABILITY=1.0
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_PROOFVAULT=INFO
