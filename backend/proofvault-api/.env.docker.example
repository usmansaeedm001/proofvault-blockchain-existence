SPRING_PROFILES_ACTIVE=docker
SERVER_PORT=8080

DB_URL=jdbc:mysql://proofvault-mysql:3306/proofvault?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=proofvault
DB_PASSWORD=change_me
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2

AUTHENTICATION_ENABLED=true
OAUTH2_ISSUER_URI=http://localhost:9000
OAUTH2_JWK_SET_URI=http://proofvault-authserver:9000/oauth2/jwks
OAUTH2_AUDIENCE=proofvault-api
OAUTH2_EMAIL_CLAIM=email
OAUTH2_NAME_CLAIM=preferred_username

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

BLOCKCHAIN_MODE=mock
BLOCKCHAIN_NETWORK=local-foundry
EXPLORER_BASE_URL=http://localhost:8545/tx/
BLOCKCHAIN_RPC_URL=http://anvil:8545
BLOCKCHAIN_CHAIN_ID=31337
BLOCKCHAIN_GAS_PRICE_WEI=1000000000
BLOCKCHAIN_GAS_LIMIT=500000
PROOFVAULT_CONTRACT_ADDRESS=
PROOFVAULT_ANCHOR_ADDRESS=
PROOFVAULT_ANCHOR_PRIVATE_KEY=

OTEL_TRACING_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces
OTEL_TRACES_SAMPLER_PROBABILITY=1.0

LOG_LEVEL_ROOT=INFO
LOG_LEVEL_PROOFVAULT=DEBUG
