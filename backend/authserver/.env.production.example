SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=9000
DB_URL=<production-auth-mysql-jdbc-url>
DB_USERNAME=<production-db-user>
DB_PASSWORD=<production-db-password>
AUTH_ISSUER=https://auth.proofvault.example
AUTH_AUDIENCE=proofvault-api
AUTH_ALLOWED_ORIGINS=https://app.proofvault.example
AUTH_BOOTSTRAP_ENABLED=false
AUTH_FRONTEND_PUBLIC_CLIENT_ID=proofvault-spa
AUTH_FRONTEND_REDIRECT_URI=https://app.proofvault.example/oauth2/callback
AUTH_FRONTEND_LOGOUT_REDIRECT_URI=https://app.proofvault.example
AUTH_SIGNING_REQUIRE_CONFIGURED_KEY=true
AUTH_SIGNING_PRIVATE_KEY_PEM=<secret-manager-value>
AUTH_SIGNING_PUBLIC_KEY_PEM=<optional-public-key-pem>
AUTH_WALLET_ENABLED=true
AUTH_WALLET_CHAIN_ID=<production-chain-id>
AUTH_WALLET_DOMAIN=app.proofvault.example
AUTH_WALLET_URI=https://app.proofvault.example
AUTH_WALLET_NONCE_TTL=5m
OTEL_TRACING_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=<production-otel-endpoint>
OTEL_TRACES_SAMPLER_PROBABILITY=0.1
